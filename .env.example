# Telegram BotFather token
BOT_TOKEN=your_bot_token_here

# Server port
PORT=3000

# Mini App HTTPS URL (ngrok / production domain)
WEBAPP_URL=https://your-domain.example

# Optional: auto HTTPS tunnel for local dev
NGROK_AUTHTOKEN=

# Super admin Telegram ID (/start da Super Admin + Admin + Foydalanuvchi)
OWNER_TELEGRAM_ID=1024063189

# Operator username (aloqa)
OPERATOR_USERNAME=jasurbek0521

# Sharhlar kanali — bot kanalda admin bo'lishi shart
# Username: @Yuan_Go   yoki   raqamli ID: -100xxxxxxxxxx
REVIEWS_CHANNEL=@Yuan_Go

# Webhook yo'li maxfiy kaliti (ixtiyoriy, lekin productionda tavsiya)
